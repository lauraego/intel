---
const { title, description, article, faqs, image, imageAlt } = Astro.props;
const canonicalPath = Astro.url.pathname.replace(/\.html$/, '');
const canonical = new URL(canonicalPath, Astro.site).href.replace(/\/$/, '') || Astro.site;
const ogImage = image ? new URL(image, Astro.site).href : null;
const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Viral Growth Media",
  url: "https://viralgrowthmedia.ai",
  founder: { "@type": "Person", name: "Laura Egocheaga" },
};
const articleLd = article ? {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: article.pubDate,
  ...(article.updatedDate ? { dateModified: article.updatedDate } : {}),
  ...(ogImage ? { image: ogImage } : {}),
  author: { "@type": "Person", name: "Laura Egocheaga", jobTitle: "Founder", url: "https://viralgrowthmedia.ai" },
  publisher: org,
  mainEntityOfPage: canonical,
} : null;
const faqLd = faqs?.length ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question", name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
} : null;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" type="application/rss+xml" title="Intel — Viral Growth Media" href="/rss.xml" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Intel by Viral Growth Media" />
  {ogImage && <meta property="og:image" content={ogImage} />}
  {ogImage && <meta property="og:image:type" content="image/webp" />}
  {ogImage && <meta property="og:image:width" content="1600" />}
  {ogImage && <meta property="og:image:height" content="900" />}
  {ogImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
  <meta name="twitter:card" content="summary_large_image" />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  {image && <link rel="preload" as="image" href={image} fetchpriority="high" />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Cormorant+Garamond:ital,wght@0,500;1,500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  {articleLd && <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />}
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
  <style is:global>
    :root{--bg:#000;--paper:#f6f1e7;--ink:#1b1712;--ink2:#4a4237;--gold:#d4af37;--gold2:#f0d060;--goldm:#b8972e;--line:rgba(27,23,18,.12)}
    *{box-sizing:border-box} html{-webkit-text-size-adjust:100%}
    body{margin:0;background:var(--paper);color:var(--ink);font:400 19px/1.62 'DM Sans',system-ui,sans-serif}
    a{color:#7a5c00}
    img{max-width:100%}
    .progress{position:fixed;top:0;left:0;height:3px;background:var(--gold);z-index:60;width:0}
    header.site{background:#000;color:#f5f0e8;display:flex;align-items:center;justify-content:space-between;padding:12px 18px;border-bottom:1px solid rgba(212,175,55,.2)}
    header.site .logo{font:700 15px/1 'Cinzel',serif;letter-spacing:.18em;color:var(--gold);text-decoration:none}
    header.site .logo small{display:block;font:500 10px/1.6 'DM Sans',sans-serif;letter-spacing:.2em;color:#b9b2a0}
    header.site a.mini{font:700 12px/1 'DM Sans';letter-spacing:.12em;text-transform:uppercase;color:#000;background:var(--gold);padding:11px 14px;border-radius:4px;text-decoration:none;min-height:44px;display:inline-flex;align-items:center}
    .wrap{max-width:680px;margin:0 auto;padding:0 20px}
    .eyebrow{font:700 11px/1.3 'DM Sans';letter-spacing:.22em;text-transform:uppercase;color:var(--gold2);margin:0 0 10px}
    h2{font:700 23px/1.25 'Cinzel',serif;margin:44px 0 14px;letter-spacing:.01em;padding-top:14px;border-top:1px solid var(--line)}
    .avatar{width:52px;height:52px;border-radius:50%;flex:none;background:#111 url(/img/laura-egocheaga-smile-cutout.webp) 50% 8%/150% no-repeat;border:2px solid var(--gold)}
    .btn{display:flex;align-items:center;justify-content:center;gap:8px;min-height:54px;padding:14px 22px;border-radius:6px;font:700 15px/1.2 'DM Sans';letter-spacing:.12em;text-transform:uppercase;text-decoration:none}
    .btn.gold{background:var(--gold);color:#000} .btn.gold:hover{background:var(--gold2)}
    footer.site{background:#000;color:#8d877a;font-size:13px;text-align:center;padding:22px 20px 100px}
    @media (min-width:900px){ body{font-size:20px} .wrap{max-width:700px} h2{font-size:28px} footer.site{padding-bottom:30px} }
  </style>
</head>
<body>
  <header class="site"><a class="logo" href="/">Intel<small>by Viral Growth Media</small></a><a class="mini" href="https://viralgrowthmedia.ai/">Scroll Scan</a></header>
  <slot />
  <footer class="site">© Viral Growth Media. Written and operated by Laura Egocheaga.</footer>
</body>
</html>
