---
// Mobile only: appears after 30% scroll, hides while the end CTA section is on screen.
---
<div class="sticky-cta" role="complementary" aria-label="Scroll Scan"><div class="t"><b>The Scroll Scan</b><span>Four coordinates. No quiz.</span></div><a class="btn gold" href="https://viralgrowthmedia.ai/">Decode your Scroll</a></div>
<script is:inline>
(function(){
  var bar=document.querySelector('.sticky-cta'); var end=document.querySelector('#end-cta'); var pr=document.querySelector('.progress');
  function upd(){
    var h=document.documentElement.scrollHeight-innerHeight; var p=h>0?scrollY/h:0;
    var endVis=false; if(end){var r=end.getBoundingClientRect(); endVis=r.top<innerHeight&&r.bottom>0;}
    bar.classList.toggle('show', p>0.30 && !endVis);
    if(pr) pr.style.width=(p*100)+'%';
  }
  addEventListener('scroll',upd,{passive:true}); addEventListener('resize',upd); upd();
})();
</script>
<style>
  .sticky-cta{position:fixed;left:0;right:0;bottom:0;z-index:50;background:rgba(0,0,0,.94);border-top:1px solid rgba(212,175,55,.45);padding:10px 14px calc(10px + env(safe-area-inset-bottom));display:flex;align-items:center;gap:12px;transform:translateY(110%);transition:transform .28s ease}
  .sticky-cta.show{transform:none}
  .t{color:#b9b2a0;font-size:12px;line-height:1.3;flex:1} .t b{display:block;color:var(--gold2);font:700 13px/1.25 'Cinzel',serif;margin-bottom:2px}
  .sticky-cta .btn{min-height:48px;padding:10px 16px;font-size:13px;flex:none}
  @media (min-width:900px){ .sticky-cta{display:none} }
</style>
